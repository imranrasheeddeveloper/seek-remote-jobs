# Local Development Environment
# Rename to .env and fill in your own values

# Database Configuration
# For local testing, you can use:
# 1. Local PostgreSQL: postgresql://localhost/jobs
# 2. Neon (free): postgresql://user:password@ep-xxx.neon.tech/jobs
# 3. Supabase (free): postgresql://postgres:password@host/postgres

DATABASE_URL=postgresql://localhost/jobs

# AI API Keys (Get free keys from these links:)
# https://ai.google.dev/
# https://console.groq.com/

GOOGLE_AI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Server Configuration
PORT=4000
NODE_ENV=development

# Optional: Admin token for forced refresh
ADMIN_REFRESH_TOKEN=your-secret-admin-token

# Puppeteer Configuration
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
