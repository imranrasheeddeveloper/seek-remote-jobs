# Production Environment Variables Template
# Copy this to .env.prod and fill in your actual values
# NEVER commit .env.prod to GitHub (add to .gitignore)

# Database Configuration
DATABASE_URL=postgresql://postgres:your-secure-password@postgres:5432/jobs
DB_PASSWORD=your-secure-password

# AI API Keys (same as local, can use different keys for production)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Server Configuration
NODE_ENV=production
PORT=4000
API_URL=https://yourdomain.com  # Frontend API URL (for CORS & frontend requests)

# Admin Token (change in production!)
ADMIN_REFRESH_TOKEN=your-secure-admin-token-here

# Optional: SSL Certificate Paths (if using HTTPS)
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Optional: Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Optional: Logging
# LOG_LEVEL=info
# SENTRY_DSN=https://your-sentry-key@sentry.io/project-id
